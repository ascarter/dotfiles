// Public user settings. Language tools and project policy belong in each
// project's mise.toml, idiomatic files, .editorconfig, and .zed/settings.json.
{
  "preview_tabs": {
    "enable_preview_multibuffer_from_code_navigation": true,
    "enable_preview_from_file_finder": true
  },
  "inlay_hints": {
    "show_background": true,
  },
  "completion_menu_scrollbar": "auto",
  "completion_menu_item_kind": "symbol",
  "collaboration_panel": {
    "dock": "right",
  },
  "cli_default_open_behavior": "new_window",
  "diff_view_style": "unified",
  "document_symbols": "on",
  "semantic_tokens": "combined",
  "redact_private_values": true,
  "document_folding_ranges": "on",
  "which_key": {
    "enabled": true,
  },
  "show_wrap_guides": true,
  "git_panel": {
    "group_by": "staging",
    "dock": "right",
    "tree_view": true,
    "collapse_untracked_diff": true,
    "status_style": "icon",
  },
  "file_finder": {
    "file_icons": false,
  },
  "current_line_highlight": "all",
  "icon_theme": "Zed (Default)",
  "terminal": {
    "blinking": "on",
  },
  "sticky_scroll": {
    "enabled": true,
  },
  "theme": {
    "mode": "system",
    "light": "Alpental Light",
    "dark": "Alpental Dark",
  },
  "ui_font_family": ".SystemUIFont",
  "ui_font_size": 14.0,
  "buffer_font_size": 13.0,
  "buffer_line_height": "comfortable",
  "show_completions_on_input": false,
  "show_edit_predictions": true,
  "edit_predictions": {
    "provider": "copilot",
    "mode": "eager",
  },
  "always_treat_brackets_as_autoclosed": true,
  "wrap_guides": [80],
  "tabs": {
    "git_status": true,
    "close_position": "left",
    "file_icons": false,
  },
  "vim_mode": true,
  "vim": {
    "use_system_clipboard": "on_yank",
    "default_mode": "normal",
    "toggle_relative_line_numbers": true,
    "use_smartcase_find": true,
  },
  "git": {
    "hunk_style": "staged_hollow",
    "inline_blame": {
      "enabled": true,
      "location": "status_bar"
    },
  },
  "project_panel": {
    "dock": "right",
    "git_status_indicator": true,
    "hide_hidden": false,
    "bold_folder_labels": true,
    "folder_icons": false,
    "git_status": true,
    "file_icons": false,
    "entry_spacing": "standard",
    "auto_fold_dirs": true,
    "indent_guides": {},
  },
  "outline_panel": {
    "dock": "right",
    "indent_guides": {
      "show": "always",
    },
  },
  "journal": {
    "hour_format": "hour24",
  },
  "auto_install_extensions": {
    "alpental-theme": true,
  },
  "agent_servers": {
    "gemini": {
      "type": "registry",
    },
    "codex-acp": {
      "favorite_config_option_values": {
        "model": [
          "gpt-5.6-terra",
          "gpt-5.6-luna",
          "gpt-5.6-sol"
        ]
      },
      "default_config_options": {
        "model": "gpt-5.6-terra",
        "reasoning_effort": "medium"
      },
      "type": "registry",
    },
    "claude-acp": {
      "default_config_options": {
        "mode": "auto"
      },
      "type": "registry",
    },
    "github-copilot-cli": {
      "default_config_options": {
        "model": "gpt-5.6-sol",
      },
      "favorite_config_option_values": {
        "model": [
          "auto",
          "gpt-5.6-sol",
          "mai-code-1-flash-picker"
        ],
      },
      "type": "registry",
    },
    "opencode": {
      "type": "registry",
    },
    "github-copilot": {
      "type": "registry",
    },
  },
  "agent": {
    "enable_feedback": false,
    "sidebar_side": "left",
    "dock": "left",
    "default_model": {
      "effort": "high",
      "provider": "copilot_chat",
      "model": "gpt-5.4",
      "enable_thinking": false,
    },
    "show_turn_stats": true,
    "tool_permissions": {
      "default": "allow",
    },
    "profiles": {},
    "use_modifier_to_send": true,
    "play_sound_when_agent_done": "when_hidden",
    "default_profile": "write",
  },
  "languages": {
    "Markdown": {
      "soft_wrap": "editor_width",
    },
  },
  "profiles": {
    "Presentation": {
      "settings": {
        "buffer_font_size": 20,
        "ui_font_size": 18,
        "theme": "Alpental Light",
        "redact_private_values": true,
      },
    },
  },
}
