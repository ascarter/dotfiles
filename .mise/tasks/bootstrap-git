#!/bin/sh
#MISE description="Configure local Git, GitHub authentication, and Git LFS"

set -eu

readonly GITCONFIG="${HOME}/.gitconfig"

log() {
  printf 'bootstrap-git: %s\n' "$*"
}

fail() {
  log "$*" >&2
  exit 1
}

has_terminal() {
  [ -r /dev/tty ] && [ -w /dev/tty ] &&
    (: </dev/tty && : >/dev/tty) 2>/dev/null
}

ensure_gitconfig() {
  [ ! -d "$GITCONFIG" ] || fail "$GITCONFIG is a directory"
  [ ! -L "$GITCONFIG" ] ||
    fail "$GITCONFIG is a symlink; replace it deliberately before continuing"

  if [ ! -e "$GITCONFIG" ]; then
    old_umask=$(umask)
    umask 077
    : >"$GITCONFIG"
    umask "$old_umask"
    log "Created $GITCONFIG"
  fi
  chmod 600 "$GITCONFIG"
}

ensure_github_login() {
  if gh auth status --active --hostname github.com >/dev/null 2>&1; then
    return 0
  fi

  has_terminal ||
    fail "GitHub login is required; rerun this task from an interactive terminal"
  printf 'GitHub authentication is required; starting the browser login.\n' >/dev/tty
  gh auth login --hostname github.com --git-protocol https --web \
    </dev/tty >/dev/tty 2>&1
}

gitconfig_clear() {
  git config --file "$GITCONFIG" --unset-all "$1" 2>/dev/null || true
}

gitconfig_replace() {
  gitconfig_clear "$1"
  git config --file "$GITCONFIG" --add "$1" "$2"
}

configure_azure_credentials() {
  if ! command -v git-credential-manager >/dev/null 2>&1; then
    log "Git Credential Manager is absent; Azure DevOps credentials were not configured"
    return 0
  fi

  gcm_path=$(command -v git-credential-manager)
  for azure_url in https://dev.azure.com 'https://*.visualstudio.com'; do
    helper_key="credential.${azure_url}.helper"
    gitconfig_clear "$helper_key"
    git config --file "$GITCONFIG" --add "$helper_key" ""
    git config --file "$GITCONFIG" --add "$helper_key" "$gcm_path"
    gitconfig_replace "credential.${azure_url}.useHttpPath" true
    gitconfig_replace "credential.${azure_url}.azreposCredentialType" oauth
  done
  log "Configured Git Credential Manager for Azure DevOps HTTPS remotes"
}

configure_github_credentials() {
  github_mise_data_dir=${MISE_DATA_DIR:-${XDG_DATA_HOME:-"$HOME/.local/share"}/mise}
  github_gh_shim="${github_mise_data_dir}/shims/gh"

  [ -x "$github_gh_shim" ] ||
    fail "mise gh shim is unavailable at $github_gh_shim"

  for github_url in https://github.com https://gist.github.com; do
    github_helper_key="credential.${github_url}.helper"
    gitconfig_clear "$github_helper_key"
    git config --file "$GITCONFIG" --add "$github_helper_key" ""
    git config --file "$GITCONFIG" --add "$github_helper_key" \
      "!\"$github_gh_shim\" auth git-credential"
  done

  log "Configured GitHub HTTPS credentials through the mise gh shim"
}

configure_diff_tools() {
  if [ "$(uname -s)" = Darwin ] && command -v opendiff >/dev/null 2>&1; then
    gitconfig_replace diff.tool opendiff
    gitconfig_replace diff.guitool opendiff
    gitconfig_replace merge.tool opendiff
    gitconfig_replace merge.guitool opendiff
    log "Configured opendiff as the macOS Git diff and merge tool"
  fi
}

command -v git >/dev/null 2>&1 || fail "git is required"
command -v gh >/dev/null 2>&1 || fail "gh was not installed by mise"
command -v git-lfs >/dev/null 2>&1 || fail "git-lfs was not installed by mise"

# Git writes `--global` changes to the XDG config when ~/.gitconfig is absent.
# Create the local file first so gh and Git LFS cannot modify the tracked XDG
# config through its symlink.
ensure_gitconfig
ensure_github_login
gh config set git_protocol https --host github.com

github_login=$(gh api user --jq .login 2>/dev/null || true)
[ -n "$github_login" ] || fail "could not determine the authenticated GitHub login"
github_name=$(gh api user --jq '.name // empty' 2>/dev/null || true)

git_name=${DOTFILES_GIT_NAME:-${github_name:-$github_login}}
git_email=${DOTFILES_GIT_EMAIL:-${github_login}@users.noreply.github.com}

gitconfig_replace user.name "$git_name"
gitconfig_replace user.email "$git_email"

# Let each owning tool reconcile its own global Git configuration.
gh auth setup-git --hostname github.com
configure_github_credentials
configure_azure_credentials
configure_diff_tools

# Install only the global filters. Repository hooks are installed when an
# LFS-enabled repository requests them; this task must not modify its own repo.
git lfs install --skip-repo

log "Git is ready for $git_name <$git_email> with GitHub HTTPS and Git LFS"
