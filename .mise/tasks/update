#!/bin/sh
#MISE description="Fast-forward and reconcile the dotfiles checkout"

set -eu

readonly DEFAULT_REPO_DIR="${HOME}/Developer/dotfiles"

log() {
  printf 'dotfiles:update: %s\n' "$*"
}

fail() {
  log "$*" >&2
  exit 1
}

usage() {
  cat <<'EOF'
Usage: mise run update [-- --dry-run | --yes]
       dotfiles-update [-- --dry-run | --yes]

Fast-forward the clean main branch of the dotfiles checkout, run its bootstrap,
and report any remaining managed-state differences.

Options:
  --dry-run  Pull changes, but only preview the bootstrap reconciliation
  --yes      Skip the bootstrap confirmation prompt
  -h, --help Show this help
EOF
}

dry_run=false
assume_yes=false

while [ "$#" -gt 0 ]; do
  case "$1" in
    --dry-run) dry_run=true ;;
    --yes) assume_yes=true ;;
    -h | --help)
      usage
      exit 0
      ;;
    *)
      usage >&2
      fail "unknown option: $1"
      ;;
  esac
  shift
done

command -v git >/dev/null 2>&1 || fail "git is required"

repo_candidate=${MISE_PROJECT_ROOT:-${DOTFILES_HOME:-$DEFAULT_REPO_DIR}}
[ -d "$repo_candidate" ] || fail "$repo_candidate is not a directory"
repo_dir=$(CDPATH= cd -P "$repo_candidate" 2>/dev/null && pwd) ||
  fail "cannot access $repo_candidate"

git -C "$repo_dir" rev-parse --is-inside-work-tree >/dev/null 2>&1 ||
  fail "$repo_dir is not a Git worktree"
[ -f "$repo_dir/.mise/config.toml" ] ||
  fail "$repo_dir is not a dotfiles checkout"

branch=$(git -C "$repo_dir" symbolic-ref --quiet --short HEAD 2>/dev/null) ||
  fail "the dotfiles checkout has a detached HEAD"
[ "$branch" = main ] ||
  fail "the dotfiles checkout is on $branch; switch to main before updating"

upstream=$(git -C "$repo_dir" rev-parse --abbrev-ref '@{upstream}' 2>/dev/null) ||
  fail "main has no upstream branch"

if [ -n "$(git -C "$repo_dir" status --porcelain --untracked-files=normal)" ]; then
  log "the checkout has local changes; resolve them before updating:" >&2
  git -C "$repo_dir" status --short >&2
  exit 1
fi

log "Fast-forwarding main from $upstream"
git -C "$repo_dir" pull --ff-only

set --
[ "$dry_run" = false ] || set -- "$@" --dry-run
[ "$assume_yes" = false ] || set -- "$@" --yes

log "Reconciling the managed environment"
"$repo_dir/bootstrap.sh" "$@"

log "Checking for remaining differences"
"$HOME/.local/bin/mise" -C "$repo_dir" bootstrap status --missing
