#autoload
# Open a man page in the platform's graphical help viewer.

manx() {
  emulate -L zsh

  local section
  local name
  case $# in
    1) name="$1" ;;
    2)
      section="$1"
      name="$2"
      ;;
    *)
      print -u2 "Usage: manx [section] name"
      return 1
      ;;
  esac

  case "$(uname)" in
    Darwin)
      if [[ -n $section ]]; then
        open "x-man-page://$section/$name"
      else
        open "x-man-page://$name"
      fi
      ;;
    Linux)
      if [[ -n $section ]]; then
        yelp "man:${name}(${section})" >/dev/null 2>&1 &
      else
        yelp "man:${name}" >/dev/null 2>&1 &
      fi
      ;;
    *)
      print -u2 "manx: unsupported platform"
      return 1
      ;;
  esac
}

